# CPU-compatible service image. The locked CUDA-enabled torch wheel is installed,
# but GPU access at runtime requires an NVIDIA Container Toolkit-enabled host.
# To use a CUDA base image later, replace this base with a compatible nvidia/cuda image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

RUN pip install --no-cache-dir "uv==0.12.2"
WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY packages/core/pyproject.toml packages/core/README.md ./packages/core/
COPY apps/api/pyproject.toml apps/api/README.md ./apps/api/
COPY packages/core/src ./packages/core/src
COPY apps/api/src ./apps/api/src

RUN uv sync --locked --no-dev --package mausamsetu-api

EXPOSE 8000
CMD ["uvicorn", "mausamsetu_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
