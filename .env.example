# Application environment
MAUSAMSETU_ENV=development
MAUSAMSETU_LOG_LEVEL=INFO

# FastAPI service
MAUSAMSETU_API_HOST=0.0.0.0
MAUSAMSETU_API_PORT=8000
MAUSAMSETU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local paths
MAUSAMSETU_DATA_DIR=./data
MAUSAMSETU_RAW_DATA_DIR=./data/raw
MAUSAMSETU_PROCESSED_DATA_DIR=./data/processed
MAUSAMSETU_CHECKPOINTS_DIR=./checkpoints
MAUSAMSETU_RUNS_DIR=./runs

# Runtime and GPU
MAUSAMSETU_DEVICE=cuda
MAUSAMSETU_MODEL_CACHE_SIZE=1

# Optional Copernicus Climate Data Store credentials
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# SvelteKit public API endpoints
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1
# Optional: required only for Cesium World Terrain service access.
PUBLIC_CESIUM_ION_ACCESS_TOKEN=
